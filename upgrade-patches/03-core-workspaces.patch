+namespace MijnGevoel.Core.Data;
+
+/// <summary>Validation and local encrypted persistence for workspace notes, tasks, and parent/guardian update drafts.</summary>
+public static class WorkspaceRecordService
+{
+    public static WorkspaceNote CreateNote(Guid id, DateTime created, string? role, string? category, string? title, string? text, bool pinned = false)
+    {
+        if (id == Guid.Empty) throw new ArgumentException("Een notitie heeft een geldig ID nodig.", nameof(id));
+        var normalizedRole = RequireRole(role);
+        var safeTitle = RequiredText(title, 120, nameof(title));
+        var safeText = (text ?? string.Empty).Trim();
+        if (safeText.Length > 8_000) throw new ArgumentException("De notitie mag maximaal 8.000 tekens bevatten.", nameof(text));
+        if (safeText.Length == 0) throw new ArgumentException("Schrijf eerst iets op.", nameof(text));
+        var safeCategory = (category ?? "Notitie").Trim();
+        if (safeCategory.Length == 0) safeCategory = "Notitie";
+        if (safeCategory.Length > 80) throw new ArgumentException("De categorie is te lang.", nameof(category));
+        return new WorkspaceNote(id, created, normalizedRole, safeCategory, safeTitle, safeText, pinned);
+    }
+
+    public static WorkspaceTask CreateTask(Guid id, DateTime created, DateTime? dueDate, string? role, string? title, string? details)
+    {
+        if (id == Guid.Empty) throw new ArgumentException("Een taak heeft een geldig ID nodig.", nameof(id));
+        var normalizedRole = RequireRole(role);
+        var safeTitle = RequiredText(title, 120, nameof(title));
+        var safeDetails = (details ?? string.Empty).Trim();
+        if (safeDetails.Length > 4_000) throw new ArgumentException("De taaknotitie mag maximaal 4.000 tekens bevatten.", nameof(details));
+        return new WorkspaceTask(id, created, dueDate?.Date, normalizedRole, safeTitle, safeDetails);
+    }
+
+    public static FamilyUpdateEntry CreateFamilyUpdate(Guid id, DateTime created, string? role, string? title, string? message)
+    {
+        if (id == Guid.Empty) throw new ArgumentException("Een update heeft een geldig ID nodig.", nameof(id));
+        var normalizedRole = RequireRole(role);
+        if (normalizedRole != WorkspaceRoleService.ParentGuardian)
+            throw new InvalidOperationException("Concept-updates voor familie zijn alleen beschikbaar in de ruimte voor ouders en voogden.");
+        var safeTitle = RequiredText(title, 120, nameof(title));
+        var safeMessage = RequiredText(message, 8_000, nameof(message));
+        return new FamilyUpdateEntry(id, created, normalizedRole, safeTitle, safeMessage, "Concept — niet gedeeld");
+    }
+
+    public static IReadOnlyList<WorkspaceNote> GetNotes(VaultStore store, string? role) =>
+        store.All<WorkspaceNote>("workspacenote").Where(x => x is not null && x.WorkspaceRole == WorkspaceRoleService.Normalize(role))
+            .OrderByDescending(x => x.Pinned).ThenByDescending(x => x.Created).ToArray();
+
+    public static IReadOnlyList<WorkspaceTask> GetTasks(VaultStore store, string? role) =>
+        store.All<WorkspaceTask>("workspacetask").Where(x => x is not null && x.WorkspaceRole == WorkspaceRoleService.Normalize(role))
+            .OrderBy(x => x.Completed).ThenBy(x => x.DueDate ?? DateTime.MaxValue).ThenByDescending(x => x.Created).ToArray();
+
+    public static IReadOnlyList<FamilyUpdateEntry> GetFamilyUpdates(VaultStore store) =>
+        store.All<FamilyUpdateEntry>("familyupdate").Where(x => x is not null && x.WorkspaceRole == WorkspaceRoleService.ParentGuardian)
+            .OrderByDescending(x => x.Created).ToArray();
+
+    public static void SaveNote(VaultStore store, WorkspaceNote note) => store.Save("workspacenote", note.Id, note);
+    public static void SaveTask(VaultStore store, WorkspaceTask task) => store.Save("workspacetask", task.Id, task);
+    public static void CompleteTask(VaultStore store, WorkspaceTask task, bool completed) => SaveTask(store, task with { Completed = completed });
+    public static void SaveFamilyUpdate(VaultStore store, FamilyUpdateEntry update) => store.Save("familyupdate", update.Id, update);
+
+    static string RequireRole(string? role)
+    {
+        if (!WorkspaceRoleService.IsKnownRole(role)) throw new ArgumentException("Kies een bekende MoodPress-omgeving.", nameof(role));
+        return WorkspaceRoleService.Normalize(role);
+    }
+
+    static string RequiredText(string? value, int maxLength, string parameterName)
+    {
+        var safe = (value ?? string.Empty).Trim();
+        if (safe.Length == 0) throw new ArgumentException("Dit veld is verplicht.", parameterName);
+        if (safe.Length > maxLength) throw new ArgumentException($"Dit veld mag maximaal {maxLength} tekens bevatten.", parameterName);
+        return safe;
+    }
+}
