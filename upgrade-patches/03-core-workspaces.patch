+namespace MijnGevoel.Core.Data;
+
+/// <summary>Recognized local workspace modes. These modes organize this account's interface; they do not grant access to another account.</summary>
+public static class WorkspaceRoleService
+{
+    public const string Personal = "Gebruiker";
+    public const string Caregiver = "Begeleider";
+    public const string ParentGuardian = "Ouder/voogd";
+
+    public static IReadOnlyList<string> Roles { get; } = new[] { Personal, Caregiver, ParentGuardian };
+
+    static readonly HashSet<string> SharedWorkspaceFeatures = new(StringComparer.Ordinal)
+    {
+        "PersonalSpace", "CaregiverSpace", "ParentGuardianSpace", "Profile", "Settings", "Privacy", "Help"
+    };
+
+    // Support accounts can plan their own work, manage an explicitly shared package, and use local support tools.
+    // They cannot browse another person's private diary, drawings, feelings history, or private check-ins.
+    static readonly HashSet<string> SupportWorkspaceFeatures = new(StringComparer.Ordinal)
+    {
+        "Agenda", "DayToday", "DayTomorrow", "Timer", "Routines", "RoutineReminders", "ChildSchedule",
+        "WhoWorks", "ReceiveSupport", "SafetyPlan", "AdultPlanning", "Wellbeing", "Week", "TalkPrep", "Notes", "Cards", "Calm", "Breath"
+    };
+
+    public static string Normalize(string? role)
+    {
+        var value = (role ?? string.Empty).Trim();
+        return Roles.FirstOrDefault(x => string.Equals(x, value, StringComparison.OrdinalIgnoreCase)) ?? Personal;
+    }
+
+    public static bool IsKnownRole(string? role) => Roles.Contains(Normalize(role), StringComparer.Ordinal) &&
+        !string.IsNullOrWhiteSpace(role) && string.Equals(Normalize(role), role.Trim(), StringComparison.OrdinalIgnoreCase);
+
+    public static string Description(string? role) => Normalize(role) switch
+    {
+        Caregiver => "Plan je begeleiding, houd eigen taken en overdrachten bij en bekijk uitsluitend informatie die bewust met jou is gedeeld.",
+        ParentGuardian => "Houd afspraken, vragen en eigen steunnotities bij. Informatie van je kind of naaste verschijnt alleen wanneer die bewust met jou is gedeeld.",
+        _ => "Leg je gevoelens vast met tekst, spraak, tekeningen en eenvoudige hulpmiddelen. Jij kiest wat je bewaart en deelt."
+    };
+
+    /// <summary>Presentation guard for feature navigation. Real separation between people comes from separate accounts and explicit encrypted share packages.</summary>
+    public static bool CanAccessFeature(string? role, string? featureKey)
+    {
+        if (string.IsNullOrWhiteSpace(featureKey)) return false;
+        if (Normalize(role) == Personal) return true;
+        return SharedWorkspaceFeatures.Contains(featureKey) || SupportWorkspaceFeatures.Contains(featureKey);
+    }
+
+    public static bool SetRole(UserSettings settings, string? role)
+    {
+        ArgumentNullException.ThrowIfNull(settings);
+        var normalized = Normalize(role);
+        bool changed = !string.Equals(settings.WorkspaceRole, normalized, StringComparison.Ordinal);
+        settings.WorkspaceRole = normalized;
+        return changed;
+    }
+}
