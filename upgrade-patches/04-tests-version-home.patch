+using MijnGevoel.Core.Data;
+using Xunit;
+
+namespace MijnGevoel.Tests;
+
+public sealed class WorkspaceRoleServiceTests
+{
+    [Theory]
+    [InlineData("Gebruiker", "Gebruiker")]
+    [InlineData("begeleider", "Begeleider")]
+    [InlineData("OUDER/VOOGD", "Ouder/voogd")]
+    [InlineData(" onbekende rol ", "Gebruiker")]
+    [InlineData(null, "Gebruiker")]
+    public void NormalizeUsesKnownSafeDefault(string? input, string expected) =>
+        Assert.Equal(expected, WorkspaceRoleService.Normalize(input));
+
+    [Fact]
+    public void ParentAndCaregiverCannotOpenPersonalDiaryFeaturesFromWorkspaceNavigation()
+    {
+        foreach (var role in new[] { WorkspaceRoleService.Caregiver, WorkspaceRoleService.ParentGuardian })
+        {
+            Assert.False(WorkspaceRoleService.CanAccessFeature(role, "Journal"));
+            Assert.False(WorkspaceRoleService.CanAccessFeature(role, "Draw"));
+            Assert.False(WorkspaceRoleService.CanAccessFeature(role, "MoodInsights"));
+            Assert.True(WorkspaceRoleService.CanAccessFeature(role, "Agenda"));
+            Assert.True(WorkspaceRoleService.CanAccessFeature(role, "ReceiveSupport"));
+        }
+    }
+
+    [Fact]
+    public void UserCanChoosePersonalFeaturesAndUnknownKeysAreDeniedForSupportRoles()
+    {
+        Assert.True(WorkspaceRoleService.CanAccessFeature(WorkspaceRoleService.Personal, "Journal"));
+        Assert.False(WorkspaceRoleService.CanAccessFeature(WorkspaceRoleService.Caregiver, "NotARealFeature"));
+        Assert.False(WorkspaceRoleService.CanAccessFeature(WorkspaceRoleService.ParentGuardian, null));
+    }
+
+    [Fact]
+    public void SetRolePersistsKnownWorkspaceChoiceInSettings()
+    {
+        var settings = new UserSettings();
+        Assert.True(WorkspaceRoleService.SetRole(settings, "Begeleider"));
+        Assert.Equal("Begeleider", settings.WorkspaceRole);
+        Assert.False(WorkspaceRoleService.SetRole(settings, "begeleider"));
+        Assert.Equal("Begeleider", settings.WorkspaceRole);
+    }
+
+    [Theory]
+    [InlineData("Gebruiker")]
+    [InlineData("Begeleider")]
+    [InlineData("Ouder/voogd")]
+    public void NotesRequireTitleAndBodyAndKeepWorkspaceRole(string role)
+    {
+        var note = WorkspaceRecordService.CreateNote(Guid.NewGuid(), DateTime.UtcNow, role, "Test", "  Titel ", "  Tekst  ");
+        Assert.Equal(role, note.WorkspaceRole);
+        Assert.Equal("Titel", note.Title);
+        Assert.Equal("Tekst", note.Text);
+    }
+
+    [Fact]
+    public void FamilyUpdatesCanOnlyBeCreatedInParentGuardianWorkspaceAndAreDrafts()
+    {
+        Assert.Throws<InvalidOperationException>(() => WorkspaceRecordService.CreateFamilyUpdate(Guid.NewGuid(), DateTime.UtcNow, "Begeleider", "Onderwerp", "Bericht"));
+        var update = WorkspaceRecordService.CreateFamilyUpdate(Guid.NewGuid(), DateTime.UtcNow, "Ouder/voogd", "Onderwerp", "Bericht");
+        Assert.Equal("Concept — niet gedeeld", update.Status);
+    }
+
+    [Fact]
+    public void NoteAndTaskInputAreValidated()
+    {
+        Assert.Throws<ArgumentException>(() => WorkspaceRecordService.CreateNote(Guid.NewGuid(), DateTime.UtcNow, "Gebruiker", "Test", "", "Tekst"));
+        Assert.Throws<ArgumentException>(() => WorkspaceRecordService.CreateNote(Guid.Empty, DateTime.UtcNow, "Gebruiker", "Test", "Titel", "Tekst"));
+        Assert.Throws<ArgumentException>(() => WorkspaceRecordService.CreateTask(Guid.NewGuid(), DateTime.UtcNow, null, "Begeleider", "", "Details"));
+    }
+}
