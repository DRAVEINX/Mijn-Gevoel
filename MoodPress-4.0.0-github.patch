+        var bytes = SupportShareService.Create("MoodPress-gebruiker", null,
+            Array.Empty<StoplichtEntry>(), Array.Empty<RoutineSuggestion>(), code, handoff: handoff);
+
+        Assert.DoesNotContain("Vandaag helpt een rustige start", Encoding.UTF8.GetString(bytes));
+        var opened = SupportShareService.Open(bytes, code);
+        Assert.NotNull(opened);
+        Assert.Equal(3, opened!.Version);
+        Assert.Equal(handoff.Id, opened.Handoff!.Id);
+        Assert.Equal(handoff.Topics, opened.Handoff.Topics);
+        Assert.False(opened.Handoff.Acknowledged);
+
+        var acknowledged = opened.Handoff with { Acknowledged = true, AcknowledgedAt = DateTime.Now };
+        var receiptCode = SupportShareService.NewShareCodeForUi();
+        var receiptBytes = SupportShareService.Create("Ontvanger", null,
+            Array.Empty<StoplichtEntry>(), Array.Empty<RoutineSuggestion>(), receiptCode, handoff: acknowledged);
+        var receipt = SupportShareService.Open(receiptBytes, receiptCode);
+        Assert.NotNull(receipt?.Handoff);
+        Assert.True(receipt!.Handoff!.Acknowledged);
+        Assert.Equal(handoff.Id, receipt.Handoff.Id);
+        Assert.NotNull(receipt.Handoff.AcknowledgedAt);
+    }
+
+    [Fact]
+    public void HandoffRejectsInvalidOrOversizedFields()
+    {
+        var invalidId = new SupportHandoffEntry(Guid.Empty, DateTime.Now, "Ikzelf", "Begeleider", "tekst", Array.Empty<string>(), false, null);
+        Assert.Throws<ArgumentException>(() => SupportShareService.Create("Sam", null, null, null, "ABCDEFGHJKLM", handoff: invalidId));
+
+        var tooLong = new SupportHandoffEntry(Guid.NewGuid(), DateTime.Now, "Ikzelf", "Begeleider", new string('x', 4001), Array.Empty<string>(), false, null);
+        Assert.Throws<ArgumentException>(() => SupportShareService.Create("Sam", null, null, null, "ABCDEFGHJKLM", handoff: tooLong));
+    }
+}
