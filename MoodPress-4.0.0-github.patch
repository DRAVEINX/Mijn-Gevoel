diff -ruN moodpress_base_flat/MijnGevoel.Android/Platforms/Android/MoodPressWidgetProvider.cs moodpress4_build/MijnGevoel.Android/Platforms/Android/MoodPressWidgetProvider.cs
--- moodpress_base_flat/MijnGevoel.Android/Platforms/Android/MoodPressWidgetProvider.cs	1970-01-01 00:00:00.000000000 +0000
+++ moodpress4_build/MijnGevoel.Android/Platforms/Android/MoodPressWidgetProvider.cs	2026-10-16 11:40:26.061474976 +0000
@@ -0,0 +1,33 @@
+using Android.App;
+using Android.Appwidget;
+using Android.Content;
+using Android.Widget;
+
+namespace MijnGevoel.AndroidApp;
+
+/// <summary>A privacy-safe launcher widget: it never exposes a mood or journal entry on the home screen.</summary>
+[BroadcastReceiver(Enabled = true, Exported = true, Label = "MoodPress")]
+[IntentFilter(new[] { AppWidgetManager.ActionAppwidgetUpdate })]
+[MetaData("android.appwidget.provider", Resource = "@xml/moodpress_widget_info")]
+public sealed class MoodPressWidgetProvider : AppWidgetProvider
+{
+    public override void OnUpdate(Context? context, AppWidgetManager? appWidgetManager, int[]? appWidgetIds)
+    {
+        if (context is null || appWidgetManager is null || appWidgetIds is null) return;
+        foreach (var appWidgetId in appWidgetIds)
+        {
+            var views = new RemoteViews(context.PackageName, Resource.Layout.moodpress_widget);
+            views.SetTextViewText(Resource.Id.widget_title, "MoodPress");
+            views.SetTextViewText(Resource.Id.widget_message, "Tik om MoodPress te openen. Je gegevens blijven privé.");
+            var launch = new Intent(context, typeof(MainActivity));
+            launch.SetFlags(ActivityFlags.NewTask | ActivityFlags.ClearTop | ActivityFlags.SingleTop);
+            var pending = PendingIntent.GetActivity(
+                context,
+                appWidgetId,
+                launch,
+                PendingIntentFlags.UpdateCurrent | PendingIntentFlags.Immutable);
+            views.SetOnClickPendingIntent(Resource.Id.widget_root, pending);
+            appWidgetManager.UpdateAppWidget(appWidgetId, views);
+        }
+    }
+}
