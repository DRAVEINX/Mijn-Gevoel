+namespace MijnGevoel.Core.Data;
+
+/// <summary>Versleutelt een volledige MoodPress-back-up voor handmatige overdracht tussen eigen apparaten.</summary>
+public static class SecureDeviceTransfer
+{
+    static readonly byte[] Magic = Encoding.ASCII.GetBytes("MPSYNC1");
+    const int SaltLength = 16, NonceLength = 12, TagLength = 16, Iterations = 310_000;
+    const int HeaderLength = 7 + SaltLength + NonceLength + TagLength;
+    const int MaxPackageBytes = 520 * 1024 * 1024;
