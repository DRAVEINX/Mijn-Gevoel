+    static async Task<byte[]> ReadLimitedAsync(Stream stream, int maxBytes)
+    {
+        using var output = new MemoryStream(); var buffer = new byte[65536];
+        while (true)
+        {
+            int count = await stream.ReadAsync(buffer.AsMemory(0, buffer.Length)); if (count == 0) break;
+            if (output.Length + count > maxBytes) throw new InvalidDataException($"Het bestand is groter dan {maxBytes / (1024 * 1024)} MB.");
+            output.Write(buffer, 0, count);
+        }
+        return output.ToArray();
+    }
