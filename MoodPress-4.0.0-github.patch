+    double CurrentWindowWidthDp()
+    {
+        // Window.Width is in device-independent units and follows split-screen/freeform resizing.
+        try
+        {
+            if (Window is not null && Window.Width > 0) return Window.Width;
+            var density = DeviceDisplay.MainDisplayInfo.Density;
+            return density > 0 ? DeviceDisplay.MainDisplayInfo.Width / density : 360;
+        }
+        catch { return 360; }
+    }
+}
