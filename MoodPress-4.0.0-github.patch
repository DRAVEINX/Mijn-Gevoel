+        editorPane.Children.Add(_boardEditorStatus);
+
+        var responsiveGrid = new Grid { ColumnSpacing = 16, RowSpacing = 16 };
+        bool? lastWide = null;
+        void UpdateLayout(bool force = false)
+        {
+            var measuredWidth = Width > 0 ? Width : CurrentWindowWidthDp();
+            var wide = measuredWidth >= 840;
+            if (!force && lastWide == wide) return;
