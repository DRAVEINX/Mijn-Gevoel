+    async Task StartReadingAsync(string source, string? customText, float rate)
+    {
+        if (_readerSentences.Length == 0) _readerSentences = BuildReaderText(source, customText);
+        if (_readerSentences.Length == 0) { _readerProgress!.Text = "Er staat geen tekst klaar om voor te lezen."; return; }
+        _readerCts?.Cancel(); _readerCts?.Dispose(); _readerCts = new CancellationTokenSource(); _readerPaused = false;
+        try
+        {
+            while (_readerSentenceIndex < _readerSentences.Length && !_readerCts.IsCancellationRequested)
+            {
+                var sentence = _readerSentences[_readerSentenceIndex];
+                _readerProgress!.Text = $"Zin {_readerSentenceIndex + 1} van {_readerSentences.Length}: {sentence}";
+                await TextToSpeech.Default.SpeakAsync(sentence, new SpeechOptions { Rate = Math.Clamp(rate, 0.5f, 1.5f) }, _readerCts.Token);
+                if (!_readerCts.IsCancellationRequested) _readerSentenceIndex++;
+            }
+            if (_readerSentenceIndex >= _readerSentences.Length) _readerProgress!.Text = "Klaar met voorlezen.";
+            else if (_readerPaused) _readerProgress!.Text = "Gepauzeerd.";
+        }
+        catch (OperationCanceledException) { /* Pause/stop is expected. */ }
+        catch (Exception ex) { AppLog.Write(ex); _readerProgress!.Text = "Voorlezen is niet beschikbaar op dit toestel."; }
+    }
