+#!/usr/bin/env bash
+set -euo pipefail
+project="MijnGevoel.Android/MijnGevoel.Android.csproj"
+ui="MijnGevoel.Android/FeaturePage.cs"
+catalog="MijnGevoel.Android/FeatureCatalog.cs"
+workflow=".github/workflows/moodpress-4-android.yml"
+test -f "$project" && test -f "$ui" && test -f "$catalog" && test -f "$workflow"
+grep -q '<ApplicationDisplayVersion>4.0.0</ApplicationDisplayVersion>' "$project"
+grep -q '<ApplicationVersion>35</ApplicationVersion>' "$project"
+grep -q 'nl.mijngevoel.app.tablet' "$project"
+grep -q 'void BuildDraw' "$ui"
+grep -q 'StartVoiceRecordingAsync' "$ui"
+grep -q 'PlayVoiceNoteAsync' "$ui"
+grep -q 'FeatureKind.WhoWorks' "$catalog"
+grep -q 'SemanticProperties.SetDescription(drawingView' "$ui"
+grep -q 'MoodPress-4.0.0-${target}.${ext}' "$workflow"
+grep -q 'CommunityToolkit.Maui" Version="15.0.1"' "$project"
+grep -q 'TryStartSpeechToTextAsync' "$ui"
+grep -q 'JournalDraftEntry' "$ui"
+grep -q 'width >= 840' "MijnGevoel.Android/DashboardPage.cs"
+grep -q 'AndroidPackageFormat' "$workflow"
+
+# New 4.0 features requested by the user: actual UI routes, secure transfer, widget and quality gates.
+extra="MijnGevoel.Android/FeaturePage.MoodPress40.cs"
+models="MijnGevoel.Core/Data/Models.cs"
+service="MijnGevoel.Core/Data/SupportShareService.cs"
+tests="MijnGevoel.Tests/SecurityTests.cs"
+test -f "$extra" && test -f "$models" && test -f "$service" && test -f "$tests"
+grep -q 'void BuildCommunicationBoard' "$extra"
+grep -q 'void BuildReadAloud' "$extra"
+grep -q 'void BuildRoutineMedia' "$extra"
+grep -q 'void BuildMoodReminders' "$extra"
+grep -q 'void BuildDifficultMomentPlan' "$extra"
+grep -q 'void BuildSecureSync' "$extra"
+grep -q 'void BuildSupportPermissions' "$extra"
+grep -q 'void BuildSupportHandoff' "$extra"
+grep -q 'void BuildBackupHealth' "$extra"
+grep -q 'void BuildAccessibilityAudit' "$extra"
+grep -q 'SupportHandoffEntry? handoff = null' "$service"
+grep -q 'HandoffRoundTripsEncryptedAndSupportsReceiptAcknowledgement' "$tests"
+grep -q 'EncryptDecryptRoundTripHidesPlaintext' "$tests"
+grep -q 'WrongPasswordAndTamperingAreRejected' "$tests"
+grep -q 'public static class SecureDeviceTransfer' 'MijnGevoel.Core/Data/SecureDeviceTransfer.cs'
+grep -q 'DetectsWhetherEncryptedRecordsBelongToTheActiveVault' "$tests"
+grep -q 'IsEncryptedRecordForCurrentKey' 'MijnGevoel.Core/Data/VaultStore.cs'
+grep -q 'BuildWeekReaderSummary' "$extra"
+test -f 'MijnGevoel.Android/Platforms/Android/MoodPressWidgetProvider.cs'
+test -f 'MijnGevoel.Android/Platforms/Android/Resources/xml/moodpress_widget_info.xml'
+grep -q 'AppWidgetProvider' 'MijnGevoel.Android/Platforms/Android/MoodPressWidgetProvider.cs'
+grep -q 'appwidget-provider' 'MijnGevoel.Android/Platforms/Android/Resources/xml/moodpress_widget_info.xml'
+echo "MoodPress 4.0 static and extended feature checks passed."
+
+# Regression checks for warnings found in the first successful Android build.
+widget="MijnGevoel.Android/Platforms/Android/MoodPressWidgetProvider.cs"
+grep -Fq 'OnUpdate(Context? context, AppWidgetManager? appWidgetManager, int[]? appWidgetIds)' "$widget"
+grep -q 'PickPhotosAsync(new MediaPickerOptions { SelectionLimit = 1 })' "$extra"
+if grep -q 'PickPhotoAsync(' "$extra"; then echo 'Obsolete single-photo picker call remains.' >&2; exit 1; fi
+if grep -q '^/// <summary>Encrypts the whole cross-device archive' "$extra"; then echo 'Dangling XML doc comment remains.' >&2; exit 1; fi
+grep -q 'actions/checkout@v7' "$workflow"
+grep -q 'actions/setup-dotnet@v6' "$workflow"
+grep -q 'actions/setup-java@v6' "$workflow"
+grep -q 'actions/upload-artifact@v7' "$workflow"
+echo "MoodPress warning-regression checks passed."
+test -f 'MijnGevoel.Android/CloudSyncClient.cs'
+test -f 'MijnGevoel.Android/CloudArchiveMerger.cs'
+test -f 'MijnGevoel.Android/FeaturePage.CloudSync.cs'
+grep -q 'BuildCloudSyncPanel' "$extra"
+grep -q 'TryAutoSyncAsync' 'MijnGevoel.Android/AppSession.cs'
+grep -q 'CloudArchiveMerger.CreateMergedArchive' 'MijnGevoel.Android/CloudSyncClient.cs'
+grep -q 'IsEncryptedRecordForCurrentKey' 'MijnGevoel.Android/CloudArchiveMerger.cs'
+echo "MoodPress cloud-sync integration checks passed."

