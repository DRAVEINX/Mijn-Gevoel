+        var wellbeing = Store.All<WellbeingEntry>("wellbeing").Where(x => x.Created.Date >= since && x.Created.Date <= today).ToList();
+        var energy = Store.All<EnergyEntry>("energy").Where(x => x.Created.Date >= since && x.Created.Date <= today).ToList();
+        var scales = Store.All<ScaleEntry>("scale").Where(x => x.Created.Date >= since && x.Created.Date <= today).ToList();
