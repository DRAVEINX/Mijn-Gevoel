+    static (bool Valid, int Count, string Hash, string Message) ValidateBackupArchive(string path)
+    {
+        using var stream = File.OpenRead(path); using var sha = SHA256.Create(); var hash = Convert.ToHexString(sha.ComputeHash(stream));
+        int count = 0; bool hasAccount = false; long total = 0;
+        using (var zip = ZipFile.OpenRead(path))
+        {
+            if (zip.Entries.Count == 0 || zip.Entries.Count > 20_000) return (false, zip.Entries.Count, hash, "Het archief bevat geen geldige set onderdelen.");
+            foreach (var entry in zip.Entries)
+            {
+                if (entry.FullName.Contains("..", StringComparison.Ordinal) || entry.FullName.StartsWith('/') || entry.FullName.Contains('\\')) return (false, zip.Entries.Count, hash, "Het archief bevat een onveilige padnaam.");
+                total += entry.Length; if (total > 512L * 1024 * 1024) return (false, zip.Entries.Count, hash, "Het archief is groter dan 512 MB.");
+                if (entry.FullName.StartsWith("accounts/", StringComparison.Ordinal) && entry.FullName.EndsWith(".json", StringComparison.Ordinal)) hasAccount = true;
+                if (entry.FullName.EndsWith('/')) continue;
+                using var input = entry.Open(); var buffer = new byte[65536]; while (input.Read(buffer, 0, buffer.Length) > 0) { }
+                count++;
+            }
+        }
+        return hasAccount && count > 0 ? (true, count, hash, "De ZIP is leesbaar en bevat een accountbestand. Geen herstel uitgevoerd.") : (false, count, hash, "Geen geldig accountbestand gevonden.");
+    }
