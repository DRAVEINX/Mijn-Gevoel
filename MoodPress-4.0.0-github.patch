+public class VaultRecordKeyValidationTests
+{
+    [Fact]
+    public void DetectsWhetherEncryptedRecordsBelongToTheActiveVault()
+    {
+        var root = Path.Combine(Path.GetTempPath(), "MoodPress-key-validation-" + Guid.NewGuid().ToString("N"));
+        var sourceDirectory = Path.Combine(root, "source");
+        var otherDirectory = Path.Combine(root, "other");
+        var sourceKey = Crypto.Random(Crypto.KeySize);
+        var otherKey = Crypto.Random(Crypto.KeySize);
+        try
+        {
+            var id = Guid.NewGuid();
+            using var source = new VaultStore((byte[])sourceKey.Clone(), sourceDirectory);
+            source.Save("diary", id, new { Text = "privé test" });
+            var path = Path.Combine(sourceDirectory, $"diary-{id:N}.mg");
+            var blob = File.ReadAllBytes(path);
+            try
+            {
+                Assert.True(source.IsEncryptedRecordForCurrentKey("diary", id, blob));
+                using var other = new VaultStore((byte[])otherKey.Clone(), otherDirectory);
+                Assert.False(other.IsEncryptedRecordForCurrentKey("diary", id, blob));
+                Assert.False(source.IsEncryptedRecordForCurrentKey("otherkind", id, blob));
+
+                // MoodPress intentionally stores the settings record under Guid.Empty; transfers must allow it.
+                source.Save("settings", Guid.Empty, new { SimplifiedMode = true });
+                var settingsBlob = File.ReadAllBytes(Path.Combine(sourceDirectory, "settings-00000000000000000000000000000000.mg"));
+                try { Assert.True(source.IsEncryptedRecordForCurrentKey("settings", Guid.Empty, settingsBlob)); }
+                finally { CryptographicOperations.ZeroMemory(settingsBlob); }
+            }
+            finally { CryptographicOperations.ZeroMemory(blob); }
+        }
+        finally
+        {
+            CryptographicOperations.ZeroMemory(sourceKey);
+            CryptographicOperations.ZeroMemory(otherKey);
+            try { if (Directory.Exists(root)) Directory.Delete(root, recursive: true); } catch { }
+        }
+    }
+}
+
+public class SecureDeviceTransferTests
+{
+    private const string Passphrase = "Mooie veilige overdracht 4.0!";
+
+    [Fact]
+    public void EncryptDecryptRoundTripHidesPlaintext()
+    {
+        var plain = Encoding.UTF8.GetBytes("persoonlijk MoodPress-overdrachtbestand");
+        var package = SecureDeviceTransfer.Encrypt(plain, Passphrase);
+        Assert.DoesNotContain("persoonlijk", Encoding.UTF8.GetString(package));
+        Assert.Equal(plain, SecureDeviceTransfer.Decrypt(package, Passphrase));
+    }
+
+    [Fact]
+    public void WrongPasswordAndTamperingAreRejected()
+    {
+        var package = SecureDeviceTransfer.Encrypt(Encoding.UTF8.GetBytes("secret"), Passphrase);
+        Assert.ThrowsAny<CryptographicException>(() => SecureDeviceTransfer.Decrypt(package, "verkeerd wachtwoord"));
+        package[^1] ^= 0x01;
+        Assert.ThrowsAny<CryptographicException>(() => SecureDeviceTransfer.Decrypt(package, Passphrase));
+    }
+
+    [Fact]
+    public void WeakPasswordAndInvalidPackagesAreRejected()
+    {
+        Assert.Throws<ArgumentException>(() => SecureDeviceTransfer.Encrypt(new byte[] { 1 }, "kort"));
+        Assert.Throws<ArgumentException>(() => SecureDeviceTransfer.Encrypt(Array.Empty<byte>(), Passphrase));
+        Assert.ThrowsAny<CryptographicException>(() => SecureDeviceTransfer.Decrypt(new byte[8], Passphrase));
+    }
+}
