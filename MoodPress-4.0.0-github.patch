diff -ruN moodpress_base_flat/.github/workflows/moodpress-4-android.yml moodpress4_build/.github/workflows/moodpress-4-android.yml
--- moodpress_base_flat/.github/workflows/moodpress-4-android.yml	1970-01-01 00:00:00.000000000 +0000
+++ moodpress4_build/.github/workflows/moodpress-4-android.yml	2026-10-16 11:40:27.161214028 +0000
@@ -0,0 +1,121 @@
+name: MoodPress 4.0 Android — telefoon en tablet
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  test-and-build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout broncode
+        uses: actions/checkout@v7
+
+      - name: Installeer .NET SDK
+        uses: actions/setup-dotnet@v6
+        with:
+          dotnet-version: |
+            8.0.x
+            10.0.x
+
+      - name: Installeer Java 17
+        uses: actions/setup-java@v6
+        with:
+          distribution: microsoft
+          java-version: '17'
+
+      - name: Installeer MAUI Android workload
+        run: dotnet workload install maui-android
+
+      - name: Controleer versie en varianten
+        shell: bash
+        run: |
+          set -euo pipefail
+          project="MijnGevoel.Android/MijnGevoel.Android.csproj"
+          grep -q '<ApplicationDisplayVersion>4.0.0</ApplicationDisplayVersion>' "$project"
+          grep -q '<ApplicationVersion>35</ApplicationVersion>' "$project"
+          grep -q 'MoodPressTarget' "$project"
+          grep -q 'nl.mijngevoel.app.tablet' "$project"
+          grep -q 'Plugin.Maui.Audio" Version="4.0.0"' "$project"
+          grep -q 'CommunityToolkit.Maui" Version="15.0.1"' "$project"
+
+      - name: Statische controles voor MoodPress 4.0
+        run: bash scripts/check-moodpress-4.sh
+
+      - name: Herstel en voer tests uit
+        run: |
+          dotnet restore MijnGevoel.Tests/MijnGevoel.Tests.csproj
+          dotnet test MijnGevoel.Tests/MijnGevoel.Tests.csproj --configuration Release --no-restore --logger "console;verbosity=normal"
+
+      - name: Decodeer Android-ondertekeningssleutel
+        shell: bash
+        env:
+          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+        run: |
+          set -euo pipefail
+          if [[ -z "${ANDROID_KEYSTORE_BASE64:-}" ]]; then
+            echo "GitHub Secret ANDROID_KEYSTORE_BASE64 ontbreekt." >&2
+            exit 1
+          fi
+          printf '%s' "$ANDROID_KEYSTORE_BASE64" | base64 --decode > "$RUNNER_TEMP/moodpress-release.keystore"
+          test -s "$RUNNER_TEMP/moodpress-release.keystore"
+          chmod 600 "$RUNNER_TEMP/moodpress-release.keystore"
+
+      - name: Bouw telefoon- en tablet-releases (APK + AAB)
+        shell: bash
+        env:
+          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+        run: |
+          set -euo pipefail
+          : "${ANDROID_KEYSTORE_PASSWORD:?GitHub Secret ANDROID_KEYSTORE_PASSWORD ontbreekt}"
+          : "${ANDROID_KEY_PASSWORD:?GitHub Secret ANDROID_KEY_PASSWORD ontbreekt}"
+          : "${ANDROID_KEY_ALIAS:?GitHub Secret ANDROID_KEY_ALIAS ontbreekt}"
+
+          project="MijnGevoel.Android/MijnGevoel.Android.csproj"
+          mkdir -p artifacts
+          for target in Phone Tablet; do
+            for format in apk aab; do
+              out="$RUNNER_TEMP/moodpress-${target}-${format}"
+              rm -rf "$out"
+              dotnet publish "$project" \
+                --configuration Release \
+                --framework net10.0-android \
+                -p:MoodPressTarget="$target" \
+                -p:AndroidPackageFormat="$format" \
+                -p:AndroidKeyStore=true \
+                "-p:AndroidSigningKeyStore=$RUNNER_TEMP/moodpress-release.keystore" \
+                "-p:AndroidSigningKeyAlias=$ANDROID_KEY_ALIAS" \
+                -p:AndroidSigningKeyPass=env:ANDROID_KEY_PASSWORD \
+                -p:AndroidSigningStorePass=env:ANDROID_KEYSTORE_PASSWORD \
+                --output "$out"
+
+              if [[ "$format" == "apk" ]]; then ext="apk"; else ext="aab"; fi
+              artifact="$(find "$out" -type f -iname "*.$ext" -print -quit)"
+              if [[ -z "$artifact" || ! -f "$artifact" ]]; then
+                echo "Geen $format gevonden voor $target." >&2
+                find "$out" -maxdepth 5 -type f -print || true
+                exit 1
+              fi
+              cp "$artifact" "artifacts/MoodPress-4.0.0-${target}.${ext}"
+            done
+          done
+
+          cd artifacts
+          sha256sum MoodPress-4.0.0-Phone.apk MoodPress-4.0.0-Phone.aab MoodPress-4.0.0-Tablet.apk MoodPress-4.0.0-Tablet.aab | tee SHA256SUMS.txt
+          ls -lh
+
+      - name: Upload de vier Android-releases
+        uses: actions/upload-artifact@v7
+        with:
+          name: MoodPress-4.0.0-Android-telefoon-tablet
+          path: artifacts/*
+          if-no-files-found: error
+          retention-days: 30
+
+      - name: Verwijder signing key
+        if: always()
+        run: rm -f "$RUNNER_TEMP/moodpress-release.keystore"
